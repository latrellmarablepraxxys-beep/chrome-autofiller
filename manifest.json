{
    "manifest_version": 3,
    "name": "PRAXXYS Autofill",
    "version": "0.1.0",
    "description": "Fill PRAXXYS admin and web forms with realistic seeded data.",
    "minimum_chrome_version": "111",
    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "tabs",
        "contextMenus"
    ],
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://dswd-web.praxxystech.com/*",
        "https://globaleight-web-staging.praxxystech.com/*",
        "https://doxo-staging-web.praxxystech.com/*",
        "https://admin.motorcentral.com.ph/*",
        "https://injoy.com.ph/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "web_accessible_resources": [
        {
            "resources": ["icons/*.png"],
            "matches": ["<all_urls>"]
        }
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "PRAXXYS Autofill",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "commands": {
        "fill-form": {
            "suggested_key": {
                "default": "Alt+Shift+B",
                "mac": "Alt+Shift+B"
            },
            "description": "Fill the current form"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "http://localhost/*",
                "http://127.0.0.1/*",
                "https://dswd-web.praxxystech.com/*",
                "https://globaleight-web-staging.praxxystech.com/*",
                "https://doxo-staging-web.praxxystech.com/*",
                "https://admin.motorcentral.com.ph/*",
                "https://injoy.com.ph/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle",
            "all_frames": false
        }
    ]
}
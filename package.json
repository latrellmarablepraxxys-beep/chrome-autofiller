{
    "name": "praxxys-autofill",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "PRAXXYS QA autofill extension for admin and web forms.",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && vite build --config vite.main.config.ts && node scripts/copy-manifest.mjs",
        "dev": "node scripts/watch.mjs",
        "harness": "vite --config vite.harness.config.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@praxxys/vue-kit": "^0.0.1",
        "@types/chrome": "^0.0.287",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^5.2.4",
        "happy-dom": "^16.7.2",
        "reka-ui": "^2.11.0",
        "typescript": "^5.7.2",
        "vite": "^6.0.7",
        "vitest": "^3.0.5",
        "vue": "^3.5.44",
        "vue-select": "^4.0.0-beta.6"
    }
}
